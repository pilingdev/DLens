rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /sightings/{id} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['lat','lng','species','timestamp','userId','confidence'])
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.species in ['aegypti','albopictus']
        && request.resource.data.timestamp is timestamp
        && request.resource.data.timestamp <= request.time + duration.value(5, 'm')
        && request.resource.data.timestamp > request.time - duration.value(7, 'd')
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
